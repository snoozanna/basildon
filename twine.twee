:: _templateStory [nobr]
<<addclass "body" "lime">>
<<include "game-intro-header">>

<main>
<div id="audio"></div>
    <div id="msgMount"> </div>
        <<if $pass>>
      
             <<set $uniqueContent to $pass+"-text">>
