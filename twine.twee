:: game3-content [nobr]

<<set _round = $roundsGame3[$roundIndexGame3]>>

<div id="gameArea3">

<<switch $game3Stage>>

<!-- ========================================================= -->
<<case "images">>

<<if $memoryTimer is undefined or $memoryTimer != 10>>
    <<set $memoryTimer = 10>>
<</if>>

<header class="game-intro-header">
    <h1>Round <<= $roundIndexGame3 + 1>></h1>

    <div class="memory-timer">
        <h2 id="memoryTimer"><<= $memoryTimer>></h2>
    </div>
</header>

<<repeat 1s>>

    <<set $memoryTimer-->>

    <<replace "#memoryTimer">>
        <<= Math.max($memoryTimer,0) >>
    <</replace>>

    <<if $memoryTimer <= 0>>
        <<stop>>
    <</if>>

<</repeat>>

<div class="game3-images">
<<if $roundIndexGame3 <= 2>>>
<<for _i, _img range _round.images>>
    <<set $imageNo to _i + 1>>
<div class="game3-image-wrapper">
    <span class="game3-image-no">$imageNo.</span>
        <div class="memory-image">
            [img[_img]]
        </div>
</div>
<</for>>
<<else>>
<<for _i, _img range _round.images>>
    <<set $imageNo to _i + 1>>
<div class="game3-image-wrapper final">
    <span class="game3-image-no">$imageNo.</span>
        <div class="memory-image">
            [img[_img]]
        </div>
</div>
<</for>>
    <</if>>

</div>

<<timed 10s>>

    <<set $memoryTimer = 10>>
    <<set $game3Stage = "questions">>

    <<replace "#gameArea3">>
        <<include "game3-content">>
    <</replace>>

<</timed>>

<!-- ========================================================= -->
<<case "questions">>

<header class="game-intro-header">
    <h1>Round <<= $roundIndexGame3 + 1>>: Questions</h1>
</header>

<ul>
<<for _q range _round.questions>>
    <li><p><<= _q.question>></p></li>
<</for>>
</ul>

<div id="revealButton"></div>

<<timed 5s>>

<<replace "#revealButton">>

<h2>Teacher, check answers.</h2>
<br/>
<<button "Reveal answers">>

    <<set $game3Stage = "answers">>

    <<replace "#gameArea3">>
        <<include "game3-content">>
    <</replace>>

<</button>>

<</replace>>

<</timed>>

<!-- ========================================================= -->
<<case "answers">>

<header class="game-intro-header">
    <h1>Round <<= $roundIndexGame3 + 1>>: Answers</h1>
</header>

<ul>

<<for _q range _round.questions>>
<li>
<p>
<<= _q.question>>
<span class="answer">
<strong>Answer:</strong>
<<= _q.answer>>
</span>
</p>
</li>
<</for>>

</ul>

<<if $roundIndexGame3 < $roundsGame3.length - 1>>

<<timed 5s>>

<<button "Next Round">>

    <<set $roundIndexGame3++>>
    <<set $game3Stage = "images">>
    <<set $memoryTimer = 10>>

    <<replace "#gameArea3">>
        <<include "game3-content">>
    <</replace>>

<</button>>

<</timed>>

<<else>>

<<button "Finish">>
    <<goto $nextpass>>
<</button>>

<</if>>

<</switch>>

</div>

:: game3-outro [nobr]
<<set $prevpass to "game3">>
<<set $pass to "game3-outro">>
<<set $nextpass to "game4-landing">>
<<audio ":all" "stop">>
<<set $currentGame = $games[3]>>
<<include "_templateStory">>

:: game3-outro-text [nobr]
  <<timed 0.1s>>
    <<append "#audio">><<if $userchoices.audioOn is true>><audio src="assets/audio/Game_3_Outro.mp3" autoplay id="bgAudio">Audio is not supported on your device</audio><</if>><</append>>
    <</timed>>
<p class="bold">GAME 3: Memory</p>
<div id="msgMount">
</div>
<p>Who got the most points? </p>
<p>We can’t see as we are pre-recorded - but well done! </p>
<p>We hope this game helps you learn your timetable</p>
<p>It’s not a fun task to do - but it will help you settle in - and not be late. </p>
<p>But where you will you go, that’s in our last game...</p>
<br/>
<p>When ready to move on, click ‘next’ for the next game. </p>

<br/>
<<button "Next">>
    <<goto $nextpass>>
    <</button>>


:: game4-landing
<<set $prevpass to "game3-outro">>
<<set $pass to "game4-landing">>
<<set $nextpass to "game4-intro">>
<<audio ":all" "stop">>

<<set $currentGame = $games[4]>>
<<include "_templateGameLanding">>


:: game4-intro [nobr]
<<set $prevpass to "game4-landing">>
<<set $pass to "game4-intro">>
<<set $nextpass to "game4">>
<<audio ":all" "stop">>

<<include "_templateStory">>

:: game4-intro-text [nobr]
  <<timed 0.1s>>
    <<append "#audio">><<if $userchoices.audioOn is true>><audio src="assets/audio/Game_4_Intro.mp3" autoplay id="bgAudio">Audio is not supported on your device</audio><</if>><</append>>
    <</timed>>
<p class="bold">GAME 4: The Tour Game</p>
<div id="msgMount">
</div>
<p>Hello everyone, and welcome to The Tour Game! </p>
<p>Now we have already played a couple of games</p>
<p>But, sadly, our time is coming to an end.</p>
<p>But don’t worry we have time for one more - The Tour Game.</p>
<p>So, how does this work? </p>
<p>You are going to receive a map that will have 5 locations written on it.</p>
<br/>
<p>At each place there will be something that you need to look out for A.K.A. a treasure hunt.  </p>
<p>These five items will give you 5 letters that will help you complete the game.  </p>
<p>Remember where you go too - it’ll help</p>
<p>Teacher, all of the information is on the MAP. </p>
<p>Good luck.</p>

<br/>
<<button "Ready">>
    <<goto $nextpass>>
    <</button>>

:: game4 [nobr]

<<set $prevpass = "game4-intro">>
<<set $pass = "game4">>
<<set $nextpass = "game4-outro">>
<<addclass "body" "school">>
<<audio ":all" "stop">>


<main>

<<include "game4-content">>

</main>

<<include "navbuttonsb">>

:: game4-content [nobr]

<<include "game4-codeword">>

:: game4-codeword [nobr]
<<set $codeword to "">>  /* ensure it's blank so the placeholder shows */

<div class="codeinput">
  <<textbox "$codeword" "">>

  <div class="input-btn">
  <<button "Enter">>
    <<set $codeword to $codeword.toUpperCase().trim()>>

    /* Correct */
    <<if $codeword is "ADAPT">>
      <<replace "#coderesult">><span>Correct!</span>
      <</replace>>
     
       <<timed 2s>>
        <<goto $nextpass>>
        <</timed>>

    <<elseif $codeword isnot "">>
      /* Incorrect (non-empty) */
      <<replace "#coderesult">><span>Try again.</span><</replace>>
      <<timed 1.5s>><<replace "#coderesult">><</replace>><</timed>>
    <</if>>
  <</button>>
  </div>
</div>
<br/>
<div id="coderesult"></div>

<<done>><<set $e to setup.addPlaceholder()>><</done>>


:: game4-outro [nobr]
<<set $prevpass to "game4">>
<<set $pass to "game4-outro">>
<<set $nextpass to "end">>
<<audio ":all" "stop">>
<<set $currentGame = $games[4]>>
<<include "_templateStory">>

:: game4-outro-text [nobr]
  <<timed 0.1s>>
    <<append "#audio">><<if $userchoices.audioOn is true>><audio src="assets/audio/BasildonOutro.mp3" autoplay id="bgAudio">Audio is not supported on your device</audio><</if>><</append>>
    <</timed>>
<p class="bold">GAME 4: Outro</p>
<div id="msgMount">
</div>
<p>You did it. </p>
<p>These are five locations that might be good to know in your first year. </p>
<p>Remember them! </p>
<p>We chose that going to a new school you have to ADAPT to new challenges, such as the school. </p>
<br/>
<p>And now we are back to where it all started, YOUR TUTOR BASE.</p>
<br/>
<p>Now, we did promise prizes didn’t we?</p>
<br/>
<p>Teacher, please hand out the spectacular smelly sticker that shows you now have the fundamentals of joining a secondary school!</p>
<br/>
<p>Remember if you have any issues, you can always go to your teacher in your tutor.</p>
<br/>
<p>Thanks for playing - and welcome to Harris Academy Kingswood. </p>
<br/>
<<button "Next">>
    <<goto $nextpass>>
    <</button>>

:: end [nobr]
<<set $prevpass to "game4-outro">>
<<set $pass to "end">>
<<set $nextpass to "end">>

<<addclass "body" "lime">>

/* <div class="hide warning"><h1>Please view this on a phone</h1></div> */
<main class="landing flex-col-cen">
<div class="stamp-container">
<img src="assets/img/stamp.png">
</div>
<p>Harris Academy Kingswood presents...</p>
<h1 class="computer">Welcome Party</h1>
  <h2 class="computer">Goodbye!</h2>
 <<button "Back">>
                <<goto $prevpass>>
            <</button>>
            <<button "Start again">>
                <<script>>
                Engine.restart()
                <</script>>
                <</button>>
</main>
